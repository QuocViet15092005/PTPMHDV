		{
			"name": "5. Qua API Gateway (có JWT)",
			"item": [
				{
					"name": "5.1 Đăng nhập (Lấy Token qua Gateway)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"try {",
									"    var jsonData = pm.response.json();",
									"    var token = jsonData.token || jsonData.accessToken || (jsonData.data && jsonData.data.token);",
									"    if (token) {",
									"        pm.collectionVariables.set(\"token\", token);",
									"    }",
									"} catch (e) {",
									"    var tokenStr = pm.response.text();",
									"    if (tokenStr) {",
									"        pm.collectionVariables.set(\"token\", tokenStr);",
									"    }",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"sv_test\",\n  \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/auth/login",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "5.2 Lấy danh sách tất cả sinh viên (Qua Gateway)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/students",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"students"
							]
						}
					},
					"response": []
